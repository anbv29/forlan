{
  "name": "byok-agent-mcp",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "service": "node src/service.mjs",
    "test:network": "node scripts/test.mjs --network",
    "test:portable": "node scripts/test.mjs --in-process"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "description": "Local BYOK coding-agent orchestration through MCP, with approvals and isolated Git worktrees",
  "bin": {
    "forlan": "src/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anbv29/forlan.git"
  },
  "files": [
    "src/",
    "scripts/",
    "test/",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "config*.example.json",
    "automation.examples.json"
  ]
}
